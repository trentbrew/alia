{
  "manifest_version": 3,
  "name": "Alia",
  "short_name": "$",
  "description": "Aliases for the omnibox ('q' + Tab), a full-window launcher for --app windows, and an Alt+L bar on any page.",
  "version": "1.1",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "$",
    "default_icon": "img/icon16.png",
    "default_popup": "popup.html"
  },
  "omnibox": {
    "keyword": "q"
  },
  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "commands": {
    "open-bar": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Open the Alia bar over the current page"
    }
  }
}
